{
  "name": "e101-electronics",
  "version": "0.1.3",
  "private": true,
  "description": "Visual electronics circuit simulator built with React, TypeScript, and Electron",
  "main": "dist/electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "electron-dev": "npm run build:electron && concurrently \"vite --port 5174\" \"npm:watch:electron\" \"wait-on http://localhost:5174 && npx electron .\"",
    "watch:electron": "tsc -p tsconfig.electron.json --watch",
    "type-check": "tsc --noEmit",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "vite build && npm run build:electron",
    "package:win": "npm run build && electron-builder --windows",
    "package:mac": "npm run build && electron-builder --mac",
    "release": "commit-and-tag-version",
    "release:first": "commit-and-tag-version --first-release",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release:dry": "commit-and-tag-version --dry-run",
    "ship": "npm run release && npm run build && git push --follow-tags origin main"
  },
  "dependencies": {
    "avr8js": "^0.21.0",
    "intel-hex": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "commit-and-tag-version": "^12.7.1",
    "concurrently": "^8.2.0",
    "electron": "^41.1.1",
    "electron-builder": "^24.7.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.example.e101",
    "files": [
      "dist/**",
      "dist/electron/**",
      "public/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    }
  }
}
